# Optional. Leave empty to run in demo mode (no real accounts).
# Get these from your Supabase project: Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Set to true only after you enable Google in Supabase (Authentication -> Providers -> Google)
VITE_ENABLE_GOOGLE=false
# Premium (3 free downloads, then a paid plan). Keep false until premium.sql, the two Supabase functions and Paystack are set up.
VITE_ENABLE_PREMIUM=false
